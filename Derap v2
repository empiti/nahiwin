    CurrentValue = cooldown,
    Callback = function(v)
        cooldown = v
    end
})

local itemCategories = {
    ["SẮT"] = {"Sheet Metal","Iron Body","Large Iron Body","Bolt","Old Car Engine","Washing Machine","Broken Microwave"},
    ["FUEL"] = {"Fuel","Fuel Canister","Oil Barrel","Gunpowder"},
    ["FOOD"] = {"Apple","Berry","Carrot","Morsel","Cooked Morsel","Steak","Cooked Steak"},
    ["KHÁC"] = {"Bandage","Log","Sapling","Coin Stack","Wolf Pelt","Bear Pelt","Cultist Gem","Hologram Emitter"}
}

local dropdownOptions = {}
for _,items in pairs(itemCategories) do
    for _,name in ipairs(items) do
        table.insert(dropdownOptions, name)
    end
end

BringTab:CreateDropdown({
    Name = "Chọn Item",
    Options = dropdownOptions,
    CurrentOption = {},
    MultipleOptions = true,
    Callback = function(opt)
        selectedItem = opt
    end
})

BringTab:CreateSection("Actions")
BringTab:CreateButton({
    Name = "BRING",
    Callback = function()
        if not selectedItem or #selectedItem == 0 then
            warn("Chưa chọn item")
            return
        end
        for _, selName in ipairs(selectedItem) do
            for _, item in ipairs(workspaceItems:GetChildren()) do
                if not item.Name:find("Chest") and item.Name == selName then
                    bringItem(item)
                    startDrag(item)
                    task.wait(cooldown)
                    stopDrag(item)
                    break
                end
            end
        end
    end
})

BringTab:CreateButton({
    Name = "BRING ALL",
    Callback = function()
        for _,item in ipairs(workspaceItems:GetChildren()) do
            if not item.Name:find("Chest") then
                bringItem(item)
                startDrag(item)
                task.wait(cooldown)
                stopDrag(item)
            end
        end
    end
})

