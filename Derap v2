--// SPEED LOCK (CHẾT / RESET VẪN GIỮ)
RunService.Heartbeat:Connect(function()
    if lockSpeed and humanoid then
        humanoid.WalkSpeed = savedSpeed
    end
end)

player.CharacterAdded:Connect(function(c)
    char = c
    humanoid = c:WaitForChild("Humanoid")
    hrp = c:WaitForChild("HumanoidRootPart")
    humanoid.WalkSpeed = savedSpeed
end)

--// AUTO TREE FARM (GIỮ NGUYÊN CODE BẠN)
local autoTreeFarmActive = false
local autoTreeFarmThread

local AuraTab = Window:CreateTab({
    Name = "Auto",
    Icon = "flash_on",
    ImageSource = "Material"
})

AuraTab:CreateToggle({
    Name = "Auto Tree Farm",
    Default = false,
    Callback = function(state)
        autoTreeFarmActive = state
        if state then
            autoTreeFarmThread = task.spawn(function()
                local ToolDamageObject = ReplicatedStorage.RemoteEvents.ToolDamageObject
                local Backpack = player:WaitForChild("Backpack")

                local function getTrees()
                    local map = workspace:FindFirstChild("Map")
                    if not map then return {} end
                    local fol = map:FindFirstChild("Foliage") or map:FindFirstChild("Landmarks")
                    if not fol then return {} end
                    local t = {}
                    for _,v in ipairs(fol:GetChildren()) do
                        if v.Name == "Small Tree" then
                            local trunk = v:FindFirstChild("Trunk")
                            if trunk then
                                table.insert(t,{tree=v,trunk=trunk})
                            end
                        end
                    end
                    return t
                end

                local function getAxe()
                    local inv = player:FindFirstChild("Inventory")
                    return inv and inv:FindFirstChildWhichIsA("Tool")
                end

                while autoTreeFarmActive do
                    for _,t in ipairs(getTrees()) do
                        if not autoTreeFarmActive then break end
                        local axe = getAxe()
                        if axe then
                            axe.Parent = char
                            hrp.CFrame = t.trunk.CFrame * CFrame.new(3,0,0)
                            ToolDamageObject:InvokeServer(
                                t.tree, axe, "1_8264699301", t.trunk.CFrame
                            )
                        end
                        task.wait(1)
                    end
                end
            end)
        else
            if autoTreeFarmThread then
                task.cancel(autoTreeFarmThread)
                autoTreeFarmThread = nil
            end
        end
    end
})
