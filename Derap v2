-- Kill Aura logic (từ script bạn tách)
RunService.Heartbeat:Connect(function()
    if killAuraEnabled then
        local c=char
        if c and c.Parent then
            for _,m in ipairs(workspace:GetDescendants()) do
                if m:IsA("Humanoid") and m.Parent~=char then
                    m.Health=0
                end
            end
        end
    end
    if treeAuraEnabled then
        for _,tree in ipairs(workspace:GetChildren()) do
            if tree.Name:find("Tree") then
                tree:Destroy()
            end
        end
    end
end)

