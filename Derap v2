    LoadingEnabled = true
})

--// TAB BRING
local Tab = Window:CreateTab({
    Name = "Bring",
    Icon = "inventory",
    ImageSource = "Material"
})

Tab:CreateSlider({
    Name = "Cooldown",
    Range = {0.05,1},
    Increment = 0.05,
    CurrentValue = cooldown,
    Callback = function(v)
        cooldown = v
    end
})

local itemCategories = {
    "Sheet Metal","Iron Body","Large Iron Body","Bolt","Fuel","Apple","Berry",
    "Bandage","Log","Sapling","Coin Stack","Wolf Pelt","Bear Pelt"
}

Tab:CreateDropdown({
    Name = "Chọn Item",
    Options = itemCategories,
    MultipleOptions = true,
    CurrentOption = nil,
    Callback = function(opt)
        selectedItem = opt or {}
    end
})

Tab:CreateButton({
    Name = "BRING",
    Callback = function()
        for _,name in ipairs(selectedItem) do
            for _,item in ipairs(workspaceItems:GetChildren()) do
                if item.Name == name then
                    bringItem(item)
                    startDrag(item)
                    task.wait(cooldown)
                    stopDrag(item)
                end
            end
        end
    end
})

Tab:CreateButton({
    Name = "BRING ALL",
    Callback = function()
        for _,item in ipairs(workspaceItems:GetChildren()) do
            bringItem(item)
            startDrag(item)
            task.wait(cooldown)
            stopDrag(item)
        end
    end
})

Tab:CreateButton({
